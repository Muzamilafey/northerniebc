# ---------------------------------------------------------------------------
# The Northern IEBC — API configuration. Copy to server/.env and fill in.
# Never commit real secrets. Generate keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind Nginx).
TRUST_PROXY=0

# MongoDB must be a replica set (transactions). Single-node "rs0" is fine for small deployments.
MONGODB_URI=mongodb://127.0.0.1:27017/northern_iebc?replicaSet=rs0
# Optional: enables Socket.IO scaling across processes and shared rate limits.
REDIS_URL=

JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PRIVILEGED_REFRESH_TOKEN_TTL_HOURS=12
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
REQUIRE_MFA_FOR_PRIVILEGED=true
# Require a different person to review imports / publish records (four-eyes principle).
FOUR_EYES_IMPORTS=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
# ClamAV daemon for malware scanning. Without it, uploads stay unservable (PENDING).
CLAMAV_HOST=
CLAMAV_PORT=3310
# Development only — never in production.
ALLOW_UNSCANNED_UPLOADS=false

# SMTP for receipts and password resets, e.g. smtps://user:pass@smtp.example.org:465
SMTP_URL=
MAIL_FROM=The Northern IEBC <no-reply@example.org>

# Legal operator — donations stay disabled ("awaiting setup") until these are set.
OPERATOR_LEGAL_NAME=
OPERATOR_CONTACT_EMAIL=
OPERATOR_CONTACT_PHONE=
OPERATOR_POSTAL_ADDRESS=
OPERATOR_REGISTRATION=
DONATION_TAX_WORDING=This receipt acknowledges a voluntary contribution. No claim of tax deductibility is made.
DONATION_MIN_KES=10
DONATION_MAX_KES=150000
DONATION_PRESETS_KES=100,250,500,1000,2500,5000
DONATION_PENDING_TIMEOUT_MINUTES=10

# M-Pesa Daraja (STK Push). Use sandbox credentials during development.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Random string of 24+ characters, embedded in the callback URL.
MPESA_CALLBACK_TOKEN=
# Optional comma-separated allowlist of Safaricom callback source IPs.
MPESA_ALLOWED_CALLBACK_IPS=
# For refunds via Transaction Reversal.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Set to true only after the live flow has been tested end to end (required in production).
MPESA_VERIFIED_OPERATIONAL=false

# Paystack (card payments via hosted checkout).
PAYSTACK_SECRET_KEY=
PAYSTACK_VERIFIED_OPERATIONAL=false

# PayPal (USD).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_VERIFIED_OPERATIONAL=false

# Optional Cloudflare Turnstile for the public citizen-report form.
TURNSTILE_SECRET_KEY=

LOG_LEVEL=info
# Set false on API instances that should not run background jobs.
RUN_WORKERS=true
