{
  "name": "@northern-iebc/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx --env-file=.env src/scripts/initDb.ts",
    "db:seed-reference": "tsx --env-file=.env src/scripts/seedReference.ts",
    "db:seed-demo": "tsx --env-file=.env src/scripts/seedDemo.ts",
    "user:create-admin": "tsx --env-file=.env src/scripts/createAdmin.ts",
    "audit:verify": "tsx --env-file=.env src/scripts/verifyAuditChain.ts",
    "load:test": "tsx --env-file=.env src/scripts/loadTest.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "csv-stringify": "6.5.2",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "multer": "2.0.2",
    "nodemailer": "6.9.16",
    "otplib": "12.0.1",
    "pdfkit": "0.15.2",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "qrcode": "1.5.4",
    "rate-limit-redis": "4.2.0",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/autocannon": "7.12.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.8",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "autocannon": "8.0.0",
    "pino-pretty": "13.0.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
